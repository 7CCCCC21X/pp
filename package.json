{
  "name": "predict-fun-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that watches Predict.fun PP-rewarded markets and alerts when the top of book hasn't moved for N hours.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "once": "node src/index.js --once",
    "get-chat-id": "node scripts/get-chat-id.js",
    "diagnose": "node scripts/diagnose.js",
    "rewards": "node scripts/rewards.js",
    "probe": "node scripts/probe.js",
    "prune-history": "node scripts/prune-history.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/*.js src/alerts/*.js scripts/*.js"
  }
}
