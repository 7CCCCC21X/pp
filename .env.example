# --- Telegram ---
# Create the bot via @BotFather, then send it /start from your account
# (or add it to a group), then run `npm run get-chat-id` to discover the id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Extra chat ids allowed to issue commands (comma separated). The main chat is
# always allowed. Useful when you want a group plus a personal DM.
TELEGRAM_ALLOWED_CHATS=
# Enable the long-polling command listener (/status /add /pause /digest ...).
TELEGRAM_COMMANDS=true

# --- Predict.fun ---
PREDICT_API_KEY=
# Comma-separated list of market ids to always monitor.
# Can be empty if AUTODISCOVER=true.
MARKET_IDS=257916
GRAPHQL_URL=https://graphql.predict.fun/graphql
REST_URL=https://api.predict.fun/v1

# REST orderbook URL shape. {key} is replaced with market[ORDERBOOK_KEY_FIELD].
# Default `conditionId` matches predict.fun. The bot self-heals: on 404 it
# falls back through alternate combinations and caches the working one.
ORDERBOOK_PATH_TEMPLATE=/markets/{key}/orderbook
ORDERBOOK_KEY_FIELD=conditionId

# How long to cache the REST /v1/markets list (used by auto-discovery and
# per-tick reward lookup). Default 10 minutes.
MARKETS_CACHE_TTL_MS=600000

# --- Polling ---
POLL_INTERVAL_MS=300000

# --- Stall alert (top-of-book frozen for N hours) ---
ALERT_STALL=true
STALE_HOURS=6
PRICE_EPSILON=0.001
TRACK_SIZE=false
SIZE_RELATIVE_EPSILON=0.10
SIZE_ABSOLUTE_MIN=10

# --- Wide-spread alert (reward zone health) ---
ALERT_WIDE_SPREAD=true
MAX_SPREAD=0.04
WIDE_SPREAD_MIN_MINUTES=15

# --- Mid-jump alert ---
ALERT_MID_JUMP=true
MID_JUMP_THRESHOLD=0.05
MID_JUMP_COOLDOWN_MS=900000

# --- Empty-book alert ---
ALERT_EMPTY_BOOK=true
EMPTY_BOOK_MIN_MINUTES=30

# Skip markets whose total hourly PP reward is 0.
SKIP_NO_REWARD=true

# --- Filters (per orderbook level 1..3) ---
# A market only emits alerts when ALL set filters pass. Empty = no filter.
# Naming: FILTER_<MIN|MAX>_<BID|ASK><1|2|3>_<PRICE|SIZE>
# Live overrides via Telegram: /setfilter minBid1Price 0.05
#FILTER_MIN_BID1_PRICE=0.05
#FILTER_MAX_BID1_PRICE=0.95
#FILTER_MIN_ASK1_PRICE=0.05
#FILTER_MAX_ASK1_PRICE=0.95
#FILTER_MIN_BID1_SIZE=100
#FILTER_MIN_ASK1_SIZE=100
#FILTER_MIN_BID2_PRICE=
#FILTER_MIN_BID2_SIZE=
# ... up to BID3 / ASK3 ...

# --- Auto-discovery ---
# When true, periodically scans /v1/markets and adds those with hourlyRate > 0
# to the watchlist. Manually /add'd ids and MARKET_IDS env are always kept;
# /remove'd ids are blacklisted from re-discovery.
AUTODISCOVER=false
DISCOVERY_INTERVAL_MS=3600000
DISCOVERY_MAX_MARKETS=200
# Filter out markets with hourlyRate below this. Useful when AUTODISCOVER=true
# to skip short-lived high-frequency markets (e.g. 15-min Bitcoin up/down at
# ~3000 PP/h that resolve before STALE_HOURS could fire).
MIN_HOURLY_RATE=0
# Skip markets ending sooner than this many hours from now. Default falls back
# to STALE_HOURS so a stall alert at least has a chance of firing before the
# market closes. Set to 0 to keep all markets regardless of remaining time.
MIN_REMAINING_HOURS=6

# --- History + daily digest ---
HISTORY_ENABLED=true
HISTORY_FILE=./history.jsonl
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_HOUR_UTC=12

# --- State persistence ---
# On Railway, attach a Volume (mount path /data) and set both files there so
# the stall timers and history survive redeploys.
STATE_FILE=./state.json
