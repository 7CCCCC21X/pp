# Telegram bot credentials. Create the bot via @BotFather, then send it a /start message
# from your account or add it to a group, then run `npm run get-chat-id` to discover the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Predict.fun REST API key (for the orderbook endpoint). The GraphQL endpoint is public.
PREDICT_API_KEY=

# Comma-separated list of market ids to monitor.
MARKET_IDS=257916

# How often to poll the API (milliseconds). Default: 5 minutes.
POLL_INTERVAL_MS=300000

# Alert when the top of book hasn't moved for at least this many hours.
STALE_HOURS=6

# Minimum absolute change in best bid/ask price to count as movement (0..1 scale).
PRICE_EPSILON=0.001

# When true, also treat a meaningful change in top-of-book size as movement.
TRACK_SIZE=false
SIZE_RELATIVE_EPSILON=0.10
SIZE_ABSOLUTE_MIN=10

# Skip markets whose total hourly PP reward is 0.
SKIP_NO_REWARD=true

# Override endpoints if needed.
GRAPHQL_URL=https://graphql.predict.fun/graphql
REST_URL=https://api.predict.fun/v1

# State persistence file.
STATE_FILE=./state.json
